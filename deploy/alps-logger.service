[Unit]
Description=ALPS pressure module web logger
After=network.target moonraker.service

[Service]
Type=simple
User=pi
WorkingDirectory=/home/pi/alps-logger
ExecStart=/home/pi/alps-logger/.venv/bin/python -m alps_logger \
    --port /dev/serial/by-id/REPLACE_WITH_YOUR_ALPS_ID \
    --moonraker http://localhost:7125 \
    --db /home/pi/printer_data/alps_logs.sqlite3 \
    --host 0.0.0.0 --web-port 8085
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
